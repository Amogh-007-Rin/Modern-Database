DATABASE_URL=mongodb://username:password@localhost:27017/modern-database?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000

# Browser origin(s) allowed to call the API (Vite dev server by default).
# Comma-separated if you serve the client from multiple origins.
CLIENT_URL=http://localhost:5173

# Base URL used to build links emailed to users (defaults to CLIENT_URL).
# WEB_URL=http://localhost:5173

# SMTP settings for transactional email (password resets). Leave unset for
# local development without email — the reset link is printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Modern Databases" <no-reply@example.com>

# Set to production for secure cookies and to hide dev-only reset tokens.
# NODE_ENV=production

# Configure any provider you want to enable. Its callback URL is:
# http://localhost:3000/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
